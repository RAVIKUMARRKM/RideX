# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL) - Using demo mode for testing
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ridex_db
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Secret
JWT_SECRET=ridex_demo_secret_key_2024
JWT_EXPIRES_IN=7d

# Google Maps API
GOOGLE_MAPS_API_KEY=demo_key

# Twilio (for SMS OTP) - Demo mode
TWILIO_ACCOUNT_SID=demo
TWILIO_AUTH_TOKEN=demo
TWILIO_PHONE_NUMBER=+1234567890

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8081

# Demo Mode (bypass real OTP for testing)
DEMO_MODE=true
DEMO_OTP=1234
